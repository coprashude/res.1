{
  "name": "proresume-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Root scripts for ProResume Builder",
  "scripts": {
    "start": "node resume-builder/server/src/index.js",
    "dev": "npm run dev:client",
    "dev:client": "npm --prefix resume-builder/client run dev",
    "dev:server": "npm --prefix resume-builder/server run dev",
    "build": "npm --prefix resume-builder/client run build",
    "install:all": "npm --prefix resume-builder/client install && npm --prefix resume-builder/server install"
  }
}
